# AihaX Environment Configuration Template
# ------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Google OAuth Web Client ID. Required for cloud deployments; verified against
# Google's token audience claim on every Google sign-in.
# Electron also reads this from its process environment or ~/AihaX/config/.env.
GOOGLE_CLIENT_ID=
AIHAX_UID=10001

# AES-256 encryption master key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIHAX_MASTER_KEY=

# Redis password
AIHAX_REDIS_PASSWORD=your-redis-password-here

# ── Owner / Freemium ──────────────────────────────────────────────────────────

# Your Google login email — the cloud issuer can mint a signed Founder entitlement for this account.
AIHAX_OWNER_EMAIL=your-email@gmail.com

# Entitlement signing keys are Ed25519 PEM files encoded as single-line base64.
# Keep the private key only in the cloud issuer; desktop installs receive only the public key.
# Generate with: openssl genpkey -algorithm Ed25519 -out entitlement-private.pem
# Export public key with: openssl pkey -in entitlement-private.pem -pubout -out entitlement-public.pem
# Encode with: openssl base64 -A -in entitlement-private.pem (and repeat for entitlement-public.pem)
# ENTITLEMENT_SIGNING_PRIVATE_KEY=
# ENTITLEMENT_VERIFICATION_PUBLIC_KEY=
# ENTITLEMENT_ISSUER=aihax-entitlement-service

# Free tier monthly scan limit (default: 3)
FREE_TIER_MONTHLY_SCANS=3

# ── Optional Cloud / Stripe ───────────────────────────────────────────────────

# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ONETIME=
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_AGENCY_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Comma-separated exact HTTPS origins allowed for Stripe success/cancel URLs.
# Local development defaults to http://localhost:3000 and 127.0.0.1:3000.
# BILLING_RETURN_ORIGINS=https://app.example.com

# Simulated purchases should stay disabled except in isolated local dev.
# DEV_MOCK_BILLING=false

# ── Optional AI ───────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
