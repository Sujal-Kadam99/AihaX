# AihaX Environment Configuration Template
# ------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# AES-256 encryption master key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIHAX_MASTER_KEY=

# Redis password
AIHAX_REDIS_PASSWORD=your-redis-password-here

# Internal OWASP ZAP API key (required by the Docker Compose ZAP service)
AIHAX_ZAP_API_KEY=replace-with-a-long-random-local-secret

# ── Owner / Freemium ──────────────────────────────────────────────────────────

# Your Google login email — grants unlimited scans when logged in via Google OAuth
AIHAX_OWNER_EMAIL=your-email@gmail.com

# Free tier monthly scan limit (default: 3)
FREE_TIER_MONTHLY_SCANS=3

# ── Optional Cloud / Stripe ───────────────────────────────────────────────────

# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ONETIME=
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_AGENCY_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=

# ── Optional AI ───────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
